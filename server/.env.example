# Port the HTTP/WebSocket server listens on (Render sets PORT automatically).
PORT=3001

# Secret used to sign JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret

# PostgreSQL connection string (local Postgres or Neon).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatter

# Origin of the web client, used for CORS.
CLIENT_ORIGIN=http://localhost:3000

# Number of reverse proxies between the internet and this server.
# Needed so rate limiting sees the visitor's real IP (see README, "Rate limiting").
# Local development: 0. Production behind Vercel + Render: measure it, see README.
TRUST_PROXY=0
